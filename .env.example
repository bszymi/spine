# Spine environment template.
# Copy to `.env` (already gitignored) and override values for your environment.
# Do NOT commit `.env`.

# --- Primary database ---
# Required in production. Used by `spine serve` and `spine migrate`.
POSTGRES_USER=spine
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=spine

# --- Registry database (shared workspace mode only) ---
POSTGRES_REGISTRY_USER=spine_registry
POSTGRES_REGISTRY_PASSWORD=change-me-in-production
POSTGRES_REGISTRY_DB=spine_registry

# --- Test databases ---
# Only needed when running `docker compose -f docker-compose.test.yaml up`.
POSTGRES_TEST_USER=spine_test
POSTGRES_TEST_PASSWORD=spine_test
POSTGRES_TEST_DB=spine_test
POSTGRES_TEST_REGISTRY_USER=spine_registry_test
POSTGRES_TEST_REGISTRY_PASSWORD=spine_registry_test
POSTGRES_TEST_REGISTRY_DB=spine_registry_test

# --- Git HTTP trusted networks ---
# Runner addresses that may clone/fetch without a bearer token when they
# connect DIRECTLY, bound to workspaces (INIT-024 TASK-006). Two forms:
#   - Single-workspace server (WORKSPACE_RESOLVER unset or file): a
#     comma-separated CIDR list, bound to the one workspace.
#   - Shared mode (WORKSPACE_RESOLVER=db or platform-binding): only the
#     per-workspace form, entries <workspace-id>=<cidr>[,<cidr>...]
#     separated by ';' — an address reads only the workspaces it is
#     listed under:
#       SPINE_GIT_HTTP_TRUSTED_CIDRS='ws-a=172.28.1.10/32;ws-b=172.28.1.11/32'
#     Keep the quotes: an unquoted ';' ends the value when the file is
#     sourced by a shell.
#     A bare list refuses to start in shared mode: it would let every
#     listed address clone every workspace's repository.
# A malformed value refuses to start. Leave empty (the default) to
# require tokens from every client. Pushes always need a token.
#
# Only a direct peer qualifies (INIT-023 TASK-015):
#   - A request whose TCP peer is in SPINE_TRUSTED_PROXY_CIDRS (a declared
#     reverse proxy) is never token-less, and no X-Forwarded-For address
#     is trusted for git access. An overlap between the two lists is
#     logged at startup: token-less clones from the overlap stop working.
#   - A request that carries a forwarding header (X-Forwarded-For,
#     Forwarded, X-Real-IP, X-Forwarded-Host, X-Forwarded-Proto, Via)
#     came through some proxy and is never token-less either.
#   - A TCP-level proxy adds no header and cannot be detected. Never
#     include a Docker bridge gateway (x.y.z.1 of the network): Docker's
#     userland proxy connects to published ports from that address, so
#     trusting it lets any process on the host clone without a token.
#     The former compose default 172.28.0.0/16 contained it.
# Set this only to the runners' own addresses, never the full RFC1918
# space. Example — a single-workspace server's runners pinned to
# 172.28.1.10 and .11 (see docker-compose.override.yaml.example for the
# recipes, including the shared-mode one):
#   SPINE_GIT_HTTP_TRUSTED_CIDRS=172.28.1.10/32,172.28.1.11/32
# SPINE_GIT_HTTP_TRUSTED_CIDRS=

# --- Git HTTP development read access ---
# Set to 1 (true/yes/on) to let every client clone/fetch over /git
# without a bearer token. Development only: spine serve refuses to start
# with it unless SPINE_ENV=development (unset or staging is refused too).
# Pushes still need a token. This is the only switch that drops git
# authentication; SPINE_DEV_MODE does not affect /git.
# SPINE_GIT_HTTP_DEV_NO_AUTH=

# --- Runtime environment (required) ---
# One of production, staging, development (case-insensitive). spine serve
# and spine secrets reencrypt refuse to start when it is unset or any
# other value (INIT-024 TASK-007): an unset or mistyped value used to run
# every production startup gate below on its lenient branch. When set to
# "production", SPINE_DEV_MODE is refused at startup — the dev-mode
# auth bypass MUST NOT be used in production — and the secret key,
# SPINE_CODE_REPO_BASE and a strong SMP_ADMIN_TOKEN are required. Left
# commented on purpose: copy-pasting a default would defeat the gate.
# SPINE_ENV=development

# --- Dev-mode auth bypass ---
# Set to 1 (or "true") to allow unauthenticated requests through
# authorize() on the /api/v1 API. Development convenience only; refused
# when SPINE_ENV=production. Leave unset for any real deployment. It does
# not affect the /git endpoint (see SPINE_GIT_HTTP_DEV_NO_AUTH).
# SPINE_DEV_MODE=

# --- Rate-limiter trusted proxies ---
# When Spine sits behind a reverse proxy (load balancer, CDN), set this
# to the proxy's CIDR so the rate limiter keys on the real client IP
# from X-Forwarded-For instead of the shared proxy address. Leaving
# this unset preserves the RemoteAddr-only behavior and is the right
# choice when the server is directly internet-facing — naive XFF
# trust would let any client forge a source IP to evade the limiter.
# Every X-Forwarded-For header line is read, right to left. A request
# from one of these proxies never gets token-less git access (see
# SPINE_GIT_HTTP_TRUSTED_CIDRS).
# Example: SPINE_TRUSTED_PROXY_CIDRS=10.0.0.0/8
# SPINE_TRUSTED_PROXY_CIDRS=

# --- Git push authentication ---
# Two modes are supported; the credential helper is the recommended
# production mode. If both are set, the helper wins and the token is
# ignored with a warning at startup.
#
# 1) Credential helper (recommended) — lets git retrieve the token
#    from the OS keychain / system secret store. The helper name must
#    be one of: cache, store, osxkeychain, manager, pass.
#    Example: SPINE_GIT_CREDENTIAL_HELPER=osxkeychain
# SPINE_GIT_CREDENTIAL_HELPER=
#
# 2) Environment-provided token — spine reads SPINE_GIT_PUSH_TOKEN at
#    startup, copies it into an in-memory GIT_ASKPASS helper, and then
#    scrubs the variable from os.Environ() so it is no longer visible
#    to child processes, /proc/<pid>/environ, or core dumps. This is a
#    step up from leaving it in the environment but the credential
#    helper above is preferable where available.
# SPINE_GIT_PUSH_TOKEN=
# SPINE_GIT_PUSH_USERNAME=x-access-token

# --- Git checkout budget (INIT-024 TASK-003) ---
# spine serve refuses to check out, merge, clone or accept a push of a
# tree over these limits (a small push can name one object from millions
# of entries, which a checkout writes in full). Unset = the default shown;
# a positive integer (bytes, no unit suffix, for the byte limits) or a
# positive duration replaces it; anything else refuses to start. There is
# no off switch. Needs git >= 2.38 (git merge-tree --write-tree).
# SPINE_GIT_TREE_MAX_ENTRIES=200000
# SPINE_GIT_TREE_MAX_BYTES=2147483648
# SPINE_GIT_TREE_MAX_PATH_BYTES=16777216
# Wall-clock deadline of every local mutating git command (not push or a
# clone's fetch); on expiry git is stopped and the operation fails.
# SPINE_GIT_MUTATE_TIMEOUT=2m

# --- Secret encryption key ---
# Base64-encoded 32-byte key used to encrypt at-rest secrets (today:
# webhook signing_secret). Required when SPINE_ENV=production; without
# it, a database compromise would hand an attacker the ability to forge
# webhook payloads. Generate one with:
#   openssl rand -base64 32
# Rows written without a key stay plaintext until the re-encryption sweep
# converts them: spine serve sweeps each workspace when it opens its store,
# and `spine secrets reencrypt [--all-workspaces]` sweeps on demand (it
# requires SPINE_SECRET_ENVELOPE_MODE set explicitly, to serve's mode, and
# without --all-workspaces SPINE_WORKSPACE_ID set to serve's id, or
# --workspace default). A
# later update does NOT re-encrypt them. Losing the key means existing ciphertext
# rows cannot be decrypted; back it up (and every retired key) alongside
# your other production secrets. See docs/integration-guide.md §2.1.
# SPINE_SECRET_ENCRYPTION_KEY=
#
# Previous keys (comma-separated base64) still DECRYPT values sealed before
# a key rotation; they never seal. Requires SPINE_SECRET_ENCRYPTION_KEY.
# Rotating with overlapping processes: first add the new key here on every
# process, then promote it to SPINE_SECRET_ENCRYPTION_KEY (moving the old
# one here). Remove a key once every workspace has swept clean under the new
# one. See docs/integration-guide.md §2.1 "Key rotation".
# SPINE_SECRET_PREVIOUS_KEYS=
#
# migrate (default): write enc:v2 (bound to the workspace and subscription),
#   accept and convert legacy enc:v1/plaintext rows.
# strict: refuse legacy enc:v1/plaintext rows. Required to close audit
#   finding P3-10; switch once every workspace has swept clean.
# downgrade: write enc:v1 and sweep back to it, before rolling back to a
#   release that cannot read enc:v2.
# SPINE_SECRET_ENVELOPE_MODE=migrate

# --- Operator token ---
# Static bearer token for system-level endpoints (workspace CRUD, etc.).
# Minimum length is 32 characters; spine serve refuses to start with a
# shorter value. Generate one with `openssl rand -hex 32`.
# Leave unset to return 503 on operator endpoints (for deployments that
# don't expose the operator surface at all).
# SPINE_OPERATOR_TOKEN=

# --- Insecure-local acknowledgement ---
# Set to 1 ONLY for local development with sslmode=disable connection URLs.
# Production deployments must leave this unset and use sslmode=require
# (or stronger). `docker-compose.yaml` sets this for the bundled local
# environment; do not set it in any real deployment.
# SPINE_INSECURE_LOCAL=1
