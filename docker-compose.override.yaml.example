# Copy this file to docker-compose.override.yaml to use local bind mounts.
#
# This mounts the current directory as the Spine repository, allowing you
# to edit artifacts locally while Spine detects changes via polling.
#
# The bind mount must be read-write — Spine needs write access for commits,
# branch creation, and merges.
#
# Caution: Both you and Spine can modify the repository simultaneously.
# Avoid editing files involved in active Runs.
#
# Security: do NOT set SPINE_GIT_RECEIVE_PACK_ENABLED=true with this bind
# mount on a macOS or Windows host. Docker Desktop shares the host
# directory with the host's case-insensitive (and, on macOS,
# normalization-insensitive) semantics, so a push to a case variant of a
# protected ref (refs/heads/MAIN) passes branch protection and can move
# or delete the protected ref itself (refs/heads/main). That holds even
# though main is a loose ref in this checkout: a hand-crafted update or
# delete that carries the ref's current object id lands on it, and once
# the ref is packed (git gc, git pack-refs) a plain git push does too.
# git's refusal to update the checked-out branch does not catch it.
# Serve pushes only from the shipped named volume (repo:/repo) or a Linux
# host directory. See KNOWN-LIMITATIONS.md -> Security Notes ("Git Push
# Gate: Served Repositories Need Case- and Normalization-Sensitive
# Storage").

services:
  spine:
    volumes:
      - ./:/repo
      - worktrees:/var/spine/worktrees
