# Copy this file to docker-compose.override.yaml to use local bind mounts.
#
# This mounts the current directory as the Spine repository, allowing you
# to edit artifacts locally while Spine detects changes via polling.
#
# The bind mount must be read-write — Spine needs write access for commits,
# branch creation, and merges.
#
# Caution: Both you and Spine can modify the repository simultaneously.
# Avoid editing files involved in active Runs.
#
# Security: do NOT set SPINE_GIT_RECEIVE_PACK_ENABLED=true with this bind
# mount on a macOS or Windows host. Docker Desktop shares the host
# directory with the host's case-insensitive (and, on macOS,
# normalization-insensitive) semantics, so a push to a case variant of a
# protected ref (refs/heads/MAIN) passes branch protection and can move
# or delete the protected ref itself (refs/heads/main). That holds even
# though main is a loose ref in this checkout: a hand-crafted update or
# delete that carries the ref's current object id lands on it, and once
# the ref is packed (git gc, git pack-refs) a plain git push does too.
# git's refusal to update the checked-out branch does not catch it.
# Serve pushes only from the shipped named volume (repo:/repo) or a Linux
# host directory. See KNOWN-LIMITATIONS.md -> Security Notes ("Git Push
# Gate: Served Repositories Need Case- and Normalization-Sensitive
# Storage").

services:
  spine:
    volumes:
      - ./:/repo
      - worktrees:/var/spine/worktrees

# --- Optional: token-less git clones for runner containers ---
#
# The base compose file trusts no network for /git: every clone presents
# a bearer token. To let runner containers clone token-less, trust ONLY
# the runners' own addresses, never a range that contains the bridge
# gateway (x.y.z.1): Docker's userland proxy forwards connections to the
# published port from that address, so trusting it lets any process on
# the host clone, without a token, every repository the address is
# trusted for.
# Requests that arrive through a declared reverse proxy
# (SPINE_TRUSTED_PROXY_CIDRS) or that carry a forwarding header
# (X-Forwarded-For, Forwarded, X-Real-IP, ...) are never token-less
# either, whatever their address. Pushes always need a token.
#
# Option A (tightest): pin each runner to a fixed address and list each
# one as a /32.
#
#   services:
#     spine:
#       environment:
#         - SPINE_GIT_HTTP_TRUSTED_CIDRS=172.28.1.10/32,172.28.1.11/32
#     runner-1:
#       networks:
#         spine-internal:
#           ipv4_address: 172.28.1.10
#
# Option B: a dedicated runner network whose ip_range excludes its own
# gateway, attached to spine and the runners only.
#
#   networks:
#     spine-runners:
#       driver: bridge
#       ipam:
#         config:
#           - subnet: 172.29.0.0/16
#             ip_range: 172.29.1.0/24     # excludes the gateway 172.29.0.1
#   services:
#     spine:
#       networks: [spine-internal, spine-runners]
#       environment:
#         - SPINE_GIT_HTTP_TRUSTED_CIDRS=172.29.1.0/24
#
# Option C: an ip_range on spine-internal itself. Note that ip_range
# applies to EVERY container on the network (spine, the databases and
# the runners), not only to runners; it still excludes the gateway.
#
#   networks:
#     spine-internal:
#       ipam:
#         config:
#           - subnet: 172.28.0.0/16
#             ip_range: 172.28.1.0/24
#   services:
#     spine:
#       environment:
#         - SPINE_GIT_HTTP_TRUSTED_CIDRS=172.28.1.0/24
#
# Options A to C are single-workspace recipes (WORKSPACE_RESOLVER unset or
# file): the bare list is bound to the one workspace.
#
# Option D (shared mode, WORKSPACE_RESOLVER=db or platform-binding): bind
# each runner address to the workspaces it serves, entries
# <workspace-id>=<cidr>[,<cidr>...] separated by ';' (INIT-024 TASK-006).
# A runner reads only the workspaces it is listed under; another
# workspace answers 401 as for any client without a token. Give each
# tenant its own runner addresses (Option A's pinning): an address listed
# under two workspaces reads both, and a job on that runner can read
# either. spine serve refuses to start in shared mode with a bare list.
#
#   services:
#     spine:
#       environment:
#         - WORKSPACE_RESOLVER=db
#         - SPINE_GIT_HTTP_TRUSTED_CIDRS=ws-a=172.28.1.10/32;ws-b=172.28.1.11/32,172.28.1.12/32
#     runner-ws-a:
#       networks:
#         spine-internal:
#           ipv4_address: 172.28.1.10
#     runner-ws-b:
#       networks:
#         spine-internal:
#           ipv4_address: 172.28.1.11
#
# Local development only: SPINE_GIT_HTTP_DEV_NO_AUTH=1 lets every client
# clone without a token, and spine serve refuses it unless
# SPINE_ENV=development.
